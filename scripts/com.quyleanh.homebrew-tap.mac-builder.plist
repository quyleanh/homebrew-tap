<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quyleanh.homebrew-tap.mac-builder</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/quyleanh/GitHub/homebrew-tap/scripts/mac_builder.sh</string>
  </array>

  <!-- Daily at 20:00 local (JST on this machine). launchd fires a missed calendar run
       on the next wake, which is the point: the machine is not always awake, and a
       build that is late costs nothing. Evening rather than morning because the
       machine is usually plugged in then — the script skips itself on battery. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <!-- No StandardOutPath/StandardErrorPath on purpose: mac_builder.sh's log() already
       appends its output to ~/Library/Logs/homebrew-tap-mac-builder.log, so also
       redirecting stdout here wrote every line twice. -->

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
